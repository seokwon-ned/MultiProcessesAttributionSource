<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.toolhub">

    <!--
        Process B (ToolHub) — Platform signed, /system/priv-app deployment assumed.

        B assembles the attribution chain, forwards to C, and performs *advisory*
        preflight (grant + AppOps fail-fast). Final authorization is always C's
        T/P/U/V pipeline (see DESIGN.md).
    -->
    <permission
        android:name="com.example.toolhub.permission.BIND_TOOLHUB"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        AppOps preflight — reading other uids' op state ("이번만 허용" 만료,
        MODE_IGNORED) requires this signature|privileged permission. Only B can
        hold it; that is exactly why this check lives here and not in C.
    -->
    <uses-permission android:name="android.permission.GET_APP_OPS_STATS" />

    <!--
        Permission mirroring (DESIGN.md 6.1) — mandatory, not optional:
        1) OS chain enforcement (checkPermissionForDataDelivery) requires EVERY
           link of the C->B->A chain to hold the permission; result data flows
           physically through B.
        2) B is also a first-party tool consumer (mode 2, executeAsHub).
        Union of all plugin action permissions goes here. B has no UI, so
        runtime grants must come from /etc/default-permissions/ pre-grant.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <application
        android:allowBackup="true"
        
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ToolHub">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            ToolHub service runs in :hub subprocess to isolate it from the main process.
            exported=true is necessary for Process A to bindService().
            Permission check provides first-line defense, but actual caller verification
            (chain authenticity + permissions) is enforced inside execute() logic.
        -->
        <service
            android:name=".ToolHubService"
            android:process=":hub"
            android:exported="true"
            android:permission="com.example.toolhub.permission.BIND_TOOLHUB" />

        <!--
            Boot receiver to awaken ToolHubService and preload plugin metadata.
            Runs in same :hub subprocess for efficiency.
            BOOT_COMPLETED is system-only broadcast, safe with exported=true.
        -->
        <receiver
            android:name=".BootCompletedReceiver"
            android:process=":hub"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
