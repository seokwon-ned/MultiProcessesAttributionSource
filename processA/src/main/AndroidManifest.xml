<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.agent">

    <!--
        Process A (Agent) must have permission to bind the ToolHub service (Process B).
    -->
    <uses-permission android:name="com.example.toolhub.permission.BIND_TOOLHUB" />

    <!--
        체인 링크로서 A도 사용하려는 툴의 권한을 보유해야 한다 (C -> B -> A 전
        링크 grant 필수 — DESIGN.md 5장). 런타임 grant는 A 자신의 권한 요청
        UI로 획득한다 (describe -> missingSelfPermissions -> requestPermissions).
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <application
        android:allowBackup="true"
        
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ToolHub">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
